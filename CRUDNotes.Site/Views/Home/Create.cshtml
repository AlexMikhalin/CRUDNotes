@model CRUDNotes.Site.Models.NoteModel

<h1>Записная книга</h1>

<form asp-action="Create" asp-controller="Home" asp-anti-forgery="true">
    <div>
        <div class="form-group">
            <label asp-for="Content">Введите Запись</label>
            <input type="text" asp-for="Content" />
        </div>
        <div class="form-group">
            <input type="submit" value="Создать запись" class="btn" />
        </div>
    </div>
</form>
